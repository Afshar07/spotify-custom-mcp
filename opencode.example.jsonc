{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Developer setup (running from source). End users get this entry written
    // automatically by Spotify Curator Setup: command is [<installed exe>, "mcp"].
    "spotify-playlists": {
      "type": "local",
      "command": ["node", "/ABSOLUTE/PATH/spotify-custom-mcp/dist/server.js"],
      "enabled": true
    }
  }
}
